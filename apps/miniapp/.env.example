# URL pública do Worker (sem barra final). Localmente, deixe vazio para usar o proxy /api do Vite.
VITE_WORKER_URL=

# Username do bot (para o link "Convidar amigos").
VITE_BOT_USERNAME=

# Modo de desenvolvimento sem Telegram. NUNCA habilite em um build de produção:
# o Worker também exige ALLOW_FAKE_INIT_DATA=1 (apenas em .dev.vars).
VITE_ENABLE_FAKE_TELEGRAM=
VITE_FAKE_USER_ID=777
VITE_FAKE_FIRST_NAME=Ana
